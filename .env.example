# Copy to .env and fill in. Never commit .env.

# --- Bases de datos: un proyecto de Supabase por microservicio ---
# Session pooler (Supabase → Connect → Session pooler). Puerto 5432 en la URL JDBC: soporta los
# prepared statements de Hibernate. El 6543 es el Transaction pooler y NO se usa (solo como último recurso,
# con prepareThreshold=0 en la URL).
# Cada servicio recibe SOLO las credenciales de su proyecto: no compartas estas variables entre servicios.
# La base de cada proyecto se llama siempre "postgres"; el esquema propio (gateway/telemetry/irrigation/ai)
# se mantiene para no exponer las tablas por la Data API de Supabase.

# api-gateway (proyecto gateway_db)
GATEWAY_DB_HOST=
GATEWAY_DB_USER=
GATEWAY_DB_PASSWORD=

# telemetry-service (proyecto telemetry_db)
TELEMETRY_DB_HOST=
TELEMETRY_DB_USER=
TELEMETRY_DB_PASSWORD=

# irrigation-service (proyecto irrigation_db)
IRRIGATION_DB_HOST=
IRRIGATION_DB_USER=
IRRIGATION_DB_PASSWORD=

# ai-service (proyecto ai_db)
AI_DB_HOST=
AI_DB_USER=
AI_DB_PASSWORD=

# Offline fallback only (compose profile "local-db" + Spring profile "localdb")
POSTGRES_USER=smartgarden
POSTGRES_PASSWORD=change-me

# Google AI Studio API key (free tier). Leave empty to use only the rule-based fallback.
GEMINI_API_KEY=
# Gemini Flash model (gemini-2.5-flash is no longer available to new API keys)
GEMINI_MODEL=gemini-3.8-flash
# Comma-separated models tried when the main one is overloaded (503), out of quota (429) or missing (404)
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest

# JWT signing secret: at least 32 characters (256 bits)
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-chars

# --- Credenciales del administrador (de un solo uso) ---
# Solo se usan la PRIMERA vez que arranca el sistema (base de datos vacía).
# Después de iniciar sesión y cambiar la contraseña, puedes borrar ADMIN_PASSWORD.
# Si ADMIN_PASSWORD está vacío, el gateway genera una contraseña aleatoria de 16 caracteres
# y la muestra UNA sola vez en el log ("Contraseña inicial del administrador: ...").
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Solo para recuperar el acceso si olvidas la contraseña. Quitar después de usar.
# ADMIN_RESET_PASSWORD=

# Garden location for Open-Meteo (default: Bogotá)
WEATHER_LAT=4.711
WEATHER_LON=-74.0721

# MQTT broker host as seen by telemetry-service. Leave unset: Docker uses "mosquitto",
# the IDE (which also reads this file) uses "localhost".
# MQTT_HOST=mosquitto
# Optional MQTT credentials (only if anonymous access is disabled)
MQTT_USERNAME=
MQTT_PASSWORD=

# Allowed CORS origins for the Angular app (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Swagger UI + /v3/api-docs del gateway. En producción: false
SPRINGDOC_ENABLED=true

# Testigo compartido por los servicios para las llamadas gRPC internas (x-internal-token).
# Vacío = desactivado. En producción genera uno largo y aleatorio.
INTERNAL_TOKEN=